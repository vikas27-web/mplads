# MPLAD SENTINEL — Environment Configuration
# Production & Local Deployment Settings

# Port on which the Next.js server runs (default: 3000)
PORT=3000

# Base URL for API calls (leave empty in standard browser deployments to use window.location.origin)
# For server-side rendering or reverse proxies:
# API_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=https://mplad-sentinel.gov.in

# SQLite Database Location (optional override, defaults to data/generated/mplad_database.sqlite)
# DATABASE_PATH=./data/generated/mplad_database.sqlite

# Application Display Branding
NEXT_PUBLIC_APP_NAME="MPLAD SENTINEL"
NEXT_PUBLIC_APP_SUBTITLE="Audit Intelligence Platform"

# Node Environment
NODE_ENV=production
