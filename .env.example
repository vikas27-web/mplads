# MPLAD SENTINEL — Environment Configuration (Production & Development)
# SIH26102 — Audit Intelligence Platform

# Server Port (default: 3000 for Next.js, 4000 for standalone API)
PORT=3000

# Base URL for API calls
# In standard browser client, defaults automatically to window.location.origin.
# Set this when deploying frontend and API to separate domains:
# NEXT_PUBLIC_API_URL=https://api.mplad-sentinel.gov.in
# API_BASE_URL=https://api.mplad-sentinel.gov.in

# SQLite Database Location
# Safe default is ./data/generated/mplad_database.sqlite.
# In containerized/persistent deployments, point to your mounted volume path:
# DATABASE_PATH=/data/mplad_database.sqlite
DATABASE_PATH=./data/generated/mplad_database.sqlite

# Anomaly Results File (default: ./data/processed/anomaly_results.json)
# ANOMALY_RESULTS_PATH=./data/processed/anomaly_results.json

# CORS Configuration (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=*

# Node Environment
NODE_ENV=production

# Application Branding
NEXT_PUBLIC_APP_NAME="MPLAD SENTINEL"
NEXT_PUBLIC_APP_SUBTITLE="Audit Intelligence Platform"
